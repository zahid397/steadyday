# Local Docker Compose settings. Run scripts/setup-env.ps1 on Windows,
# or copy this file to .env and generate a password for a fresh database.
# Keep the original credentials when reusing an initialized volume.
APP_PORT=8000
POSTGRES_USER=steadyday
POSTGRES_DB=steadyday
POSTGRES_PASSWORD=
DEMO_TIMEZONE=Asia/Dhaka
DEMO_SESSION_DAYS=7
DEMO_SESSION_LIMIT=300
RETRIEVAL_ENABLED=1

# Optional image overrides for networks that cannot reach Docker Hub.
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-bookworm
